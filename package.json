    "eslint-plugin-svelte": "^2.36.0",
    "font-awesome": "^4.7.0",
    "globals": "^15.0.0",
    "leaflet": "^1.7.1",
    "leaflet-defaulticon-compatibility": "^0.1.1",
    "leaflet-draw": "^1.0.4",
    "leaflet-geometryutil": "^0.10.0",
    "leaflet-semicircle": "^2.0.4",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.2.6",
    "sass": "^1.81.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
